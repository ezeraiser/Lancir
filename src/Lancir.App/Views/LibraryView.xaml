<UserControl x:Class="Lancir.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lancir.App.Markup"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Lancir.App.ViewModels"
             xmlns:ctrl="clr-namespace:Lancir.App.Controls"
             xmlns:svc="clr-namespace:Lancir.App.Services"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}">
    <UserControl.Resources>
        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="GameCardSelectedStyle" TargetType="Border" BasedOn="{StaticResource GameCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style x:Key="PlayOverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#80000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="GameContextMenu" x:Shared="False">
            <MenuItem Header="{loc:Tr 'Detaylar / Düzenle'}"
                      Command="{Binding PlacementTarget.Tag.OpenDetailsCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Edit24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr 'Üst Veri Getir'}" IsEnabled="{Binding CanMatch}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="CloudArrowDown24" />
                </MenuItem.Icon>
                <MenuItem Header="{loc:Tr 'Steam\'den'}"
                          Command="{Binding PlacementTarget.Tag.MatchWithSteamCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Games24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Tr 'SteamGridDB\'den'}"
                          Command="{Binding PlacementTarget.Tag.MatchWithSteamGridDbCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Image24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Tr 'IGDB\'den'}"
                          Command="{Binding PlacementTarget.Tag.MatchWithIgdbCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Database24" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:Tr 'Özel kütüphaneye ekle'}" SubmenuOpened="OnLibrariesSubmenuOpened">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderAdd24" />
                </MenuItem.Icon>
                <MenuItem Header="…" IsEnabled="False" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Tr 'Kaldır'}"
                      Command="{Binding PlacementTarget.Tag.RemoveGameCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding ScopeTitle}" FontSize="26" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <!-- filter chips: pick several; any chosen status, plus favorites when that chip is on -->
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <ToggleButton IsChecked="{Binding FilterPlaying}" Margin="0,0,6,6" Padding="10,7" ToolTip="{loc:Tr 'Oynuyorum'}" AutomationProperties.Name="{loc:Tr 'Oynuyorum'}">
                    <ui:SymbolIcon Symbol="Play24" FontSize="16" />
                </ToggleButton>
                <ToggleButton IsChecked="{Binding FilterFinished}" Margin="0,0,6,6" Padding="10,7" ToolTip="{loc:Tr 'Bitirdim'}" AutomationProperties.Name="{loc:Tr 'Bitirdim'}">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" />
                </ToggleButton>
                <ToggleButton IsChecked="{Binding FilterDropped}" Margin="0,0,6,6" Padding="10,7" ToolTip="{loc:Tr 'Bıraktım'}" AutomationProperties.Name="{loc:Tr 'Bıraktım'}">
                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="16" />
                </ToggleButton>
                <ToggleButton IsChecked="{Binding FilterBacklog}" Margin="0,0,6,6" Padding="10,7" ToolTip="{loc:Tr 'Listede'}" AutomationProperties.Name="{loc:Tr 'Listede'}">
                    <ui:SymbolIcon Symbol="Bookmark24" FontSize="16" />
                </ToggleButton>
                <!-- the four statuses add up; favorites is a separate filter on top of them -->
                <Border Width="2" Height="26" Margin="6,1,12,6" CornerRadius="1" Background="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.7" />
                <ToggleButton IsChecked="{Binding FilterFavorites}" Margin="0,0,6,6" Padding="10,7" ToolTip="{loc:Tr 'Yalnızca favoriler'}" AutomationProperties.Name="{loc:Tr 'Favoriler'}">
                    <ui:SymbolIcon Symbol="Star24" FontSize="16" />
                </ToggleButton>
                <ui:Button Icon="{ui:SymbolIcon FilterDismiss24}" Command="{Binding ClearFiltersCommand}" Appearance="Transparent" Padding="10,7" Margin="0,0,6,6"
                           ToolTip="{loc:Tr 'Filtreyi temizle'}" AutomationProperties.Name="{loc:Tr 'Filtreyi temizle'}">
                    <ui:Button.Visibility>
                        <Binding Path="HasActiveFilter" Converter="{StaticResource NullToVisibilityConverter}" />
                    </ui:Button.Visibility>
                </ui:Button>
            </WrapPanel>
        </Grid>

        <ui:InfoBar Grid.Row="1" Severity="Error" Title="{loc:Tr 'Hata'}" IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                    Message="{Binding ErrorMessage}" Margin="0,0,0,12">
            <ui:InfoBar.Visibility>
                <Binding Path="ErrorMessage" Converter="{StaticResource NullToVisibilityConverter}" />
            </ui:InfoBar.Visibility>
        </ui:InfoBar>

        <Grid Grid.Row="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Visibility>
                    <Binding Path="IsScopeEmpty" Converter="{StaticResource NullToVisibilityConverter}" />
                </StackPanel.Visibility>
                <ui:SymbolIcon Symbol="Library24" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr 'Bu kütüphanede oyun yok'}" FontSize="15" Margin="0,12,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr 'Oyunların sağ tık menüsünden ya da durum seçiminden ekleyebilirsiniz'}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Visibility>
                    <Binding Path="Games.Count" Converter="{StaticResource NullToVisibilityConverter}"
                             ConverterParameter="Invert" />
                </StackPanel.Visibility>
                <ui:SymbolIcon Symbol="XboxController24" FontSize="40"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr 'Henüz kütüphanenizde oyun yok'}" FontSize="15" Margin="0,12,0,4"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr 'Ayarlar → Klasör Tara bölümünden başlayın'}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Visibility>
                    <Binding Path="IsListView" Converter="{StaticResource NullToVisibilityConverter}" ConverterParameter="Invert" />
                </ScrollViewer.Visibility>
                <ItemsControl ItemsSource="{Binding GamesView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LibraryGameViewModel}">
                            <Border Width="176" Margin="0,0,16,16"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AllowDrop="True" PreviewMouseLeftButtonDown="OnItemMouseDown" MouseMove="OnItemMouseMove"
                                    DragEnter="OnItemDragOver" DragOver="OnItemDragOver" DragLeave="OnItemDragLeave" Drop="OnItemDrop"
                                    MouseLeftButtonUp="OnCardClick" Cursor="Hand"
                                    ContextMenu="{StaticResource GameContextMenu}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GameCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <Grid x:Name="CoverGrid" Height="230">
                                        <Border CornerRadius="12,12,0,0" ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="174" Height="230" CornerRadius="11,11,0,0" Background="White" />
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Grid.OpacityMask>
                                                <ui:SymbolIcon Symbol="ImageProhibited24" FontSize="28"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image ctrl:AsyncImage.DecodeWidth="360" ctrl:AsyncImage.Source="{Binding CoverImagePath}" ctrl:AsyncImage.Stamp="{Binding CoverStamp}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <Button x:Name="PlayOverlayButton" Style="{StaticResource PlayOverlayButtonStyle}"
                                                Width="52" Height="52" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowGridPlayButton, Source={x:Static svc:UiPreferences.Instance},
                                                             Converter={StaticResource NullToVisibilityConverter}}"
                                                Command="{Binding DataContext.LaunchGameCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="22" />
                                        </Button>
                                    </Grid>

                                    <StackPanel Margin="10,10,10,12">
                                        <TextBlock Text="{Binding DisplayName}" Margin="0,0,0,4"
                                                   Style="{StaticResource GameNameCardStyle}"
                                                   MinHeight="{Binding CardTwoLineHeight, Source={x:Static svc:GameNameAppearance.Instance}}"
                                                   ToolTip="{Binding DisplayName}" />

                                        <TextBlock Text="{Binding PlaytimeText}" FontSize="8"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="CoverGrid" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PlayOverlayButton" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Visibility>
                    <Binding Path="IsListView" Converter="{StaticResource NullToVisibilityConverter}" />
                </ScrollViewer.Visibility>
                <ItemsControl ItemsSource="{Binding GamesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LibraryGameViewModel}">
                            <Border Margin="0,0,16,3" MinHeight="46" Padding="6,4"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AllowDrop="True" PreviewMouseLeftButtonDown="OnItemMouseDown" MouseMove="OnItemMouseMove"
                                    DragEnter="OnItemDragOver" DragOver="OnItemDragOver" DragLeave="OnItemDragLeave" Drop="OnItemDrop"
                                    MouseLeftButtonUp="OnCardClick" Cursor="Hand"
                                    ContextMenu="{StaticResource GameContextMenu}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GameCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="ListCoverGrid" Grid.Column="0" Width="30" Margin="0,0,12,0">
                                        <Border CornerRadius="4" ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image ctrl:AsyncImage.DecodeWidth="80" ctrl:AsyncImage.Source="{Binding CoverImagePath}" ctrl:AsyncImage.Stamp="{Binding CoverStamp}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <Button x:Name="ListPlayButton" Style="{StaticResource PlayOverlayButtonStyle}"
                                                Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding DataContext.LaunchGameCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="10" />
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource GameNameListStyle}"
                                                   ToolTip="{Binding DisplayName}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ListCoverGrid" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ListPlayButton" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
