<ui:FluentWindow x:Class="Lancir.App.Views.MatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lancir.App.Markup"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Lancir.App.ViewModels"
        xmlns:models="clr-namespace:Lancir.Core.Models;assembly=Lancir.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MatchPickerViewModel}"
        Title="{loc:Tr 'Eşleşme Seç'}" Height="520" Width="460"
        MinHeight="380" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr 'Eşleşme Seç'}" ShowMaximize="False" ShowMinimize="False" />

        <TextBlock Grid.Row="1" Margin="20,4,20,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="{Binding HeaderText, Mode=OneWay}" />
        </TextBlock>

        <ScrollViewer Grid.Row="2" Margin="20,0,20,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MatchCandidate}">
                        <Button Click="OnCandidateClick" Tag="{Binding}"
                                HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Padding="10"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="70" CornerRadius="6" ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Image Source="{Binding CoverImageUrl, Converter={StaticResource UrlToImageConverter}, ConverterParameter=140}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ReleaseDateUtc, StringFormat=' ({0:yyyy})'}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Visibility>
                                                <Binding Path="ReleaseDateUtc" Converter="{StaticResource NullToVisibilityConverter}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Source}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                               MaxHeight="48" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                                        <TextBlock.Visibility>
                                            <Binding Path="Description" Converter="{StaticResource NullToVisibilityConverter}" />
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{loc:Tr 'Sonuç bulunamadı.'}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock.Visibility>
                <Binding Path="Candidates.Count" Converter="{StaticResource NullToVisibilityConverter}" ConverterParameter="Invert" />
            </TextBlock.Visibility>
        </TextBlock>

        <ui:Button Grid.Row="3" Content="{loc:Tr 'İptal'}" HorizontalAlignment="Right" Margin="20,12,20,0"
                   Click="OnCancelClick" />
    </Grid>
</ui:FluentWindow>
