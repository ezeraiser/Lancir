<Window x:Class="Lancir.App.Views.ChoiceDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Width="460" WindowStyle="ToolWindow"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="22,20,22,20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel x:Name="Buttons" />
    </StackPanel>
</Window>
