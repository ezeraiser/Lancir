<UserControl x:Class="Lancir.App.Views.ScanReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lancir.App.Markup"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Lancir.App.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanReviewViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="{loc:Tr 'Klasör Tara'}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,16" />

        <!-- Watched folders -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Tr 'İzlenen Klasörler'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="{loc:Tr 'Klasör Ekle'}" Icon="{ui:SymbolIcon FolderAdd24}"
                               Appearance="Secondary" Command="{Binding AddFolderCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding WatchedFolders}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                           Command="{Binding DataContext.RemoveFolderCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Tr 'Henüz klasör eklenmedi'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,4,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="WatchedFolders.Count" Converter="{StaticResource NullToVisibilityConverter}"
                                 ConverterParameter="Invert" />
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="{loc:Tr 'Yeniden Tara'}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Appearance="Primary" Command="{Binding ScanCommand}" />
            <ui:ProgressRing Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Width="20" Height="20"
                              HorizontalAlignment="Left" Margin="12,0,0,0">
                <ui:ProgressRing.Visibility>
                    <Binding Path="IsBusy" Converter="{StaticResource NullToVisibilityConverter}" />
                </ui:ProgressRing.Visibility>
            </ui:ProgressRing>
        </Grid>

        <ui:InfoBar Grid.Row="3" Severity="Error" Title="{loc:Tr 'Hata'}" IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                    Message="{Binding ErrorMessage}" Margin="0,0,0,12">
            <ui:InfoBar.Visibility>
                <Binding Path="ErrorMessage" Converter="{StaticResource NullToVisibilityConverter}" />
            </ui:InfoBar.Visibility>
        </ui:InfoBar>

        <Grid Grid.Row="4">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Visibility>
                    <Binding Path="Items.Count" Converter="{StaticResource NullToVisibilityConverter}"
                             ConverterParameter="Invert" />
                </StackPanel.Visibility>
                <ui:SymbolIcon Symbol="FolderSearch24" FontSize="32"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr 'Taranacak yeni oyun bulunamadı'}" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScanReviewItemViewModel}">
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RawFolderName}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ui:Button Grid.Column="1" Content="{loc:Tr 'Bu klasörü yoksay'}" FontSize="11"
                                                       Appearance="Transparent" Padding="6,2"
                                                       Command="{Binding DataContext.IgnoreFolderCommand,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                        <ui:TextBox Text="{Binding SuggestedName, UpdateSourceTrigger=PropertyChanged}"
                                                    Margin="0,0,0,8" />

                                        <TextBlock Text="{loc:Tr 'Çalıştırılabilir dosya seçin:'}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,0,0,2">
                                            <TextBlock.Visibility>
                                                <Binding Path="HasNoExecutable" Converter="{StaticResource NullToVisibilityConverter}"
                                                         ConverterParameter="Invert" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding ExecutableCandidates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ExecutableCandidateViewModel}">
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                                  ToolTip="{Binding FullPath}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{Binding IconSource}" Width="16" Height="16"
                                                                       Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding RelativePath}" FontSize="12"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <ui:Button Grid.Column="1" Content="{loc:Tr 'Yoksay'}" FontSize="11"
                                                                   Appearance="Transparent" Padding="6,2"
                                                                   Command="{Binding DataContext.IgnoreExecutableCommand,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{loc:Tr 'Bu klasörde çalıştırılabilir dosya bulunamadı'}" FontSize="12"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                            <TextBlock.Visibility>
                                                <Binding Path="HasNoExecutable" Converter="{StaticResource NullToVisibilityConverter}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <ui:Button Content="{loc:Tr 'Ekle'}" Appearance="Primary" Margin="0,0,0,6"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                   Command="{Binding DataContext.ConfirmCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Content="{loc:Tr 'Atla'}" Appearance="Transparent"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                   Command="{Binding DataContext.SkipCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <ui:Button Grid.Row="5" Content="{loc:Tr 'Bitir'}" Appearance="Secondary" HorizontalAlignment="Right"
                   Margin="0,12,0,0" Command="{Binding FinishCommand}" />
    </Grid>
</UserControl>
