<Window x:Class="Lancir.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Width="380" WindowStyle="ToolWindow"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" MaxLength="40" KeyDown="OnInputKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button x:Name="OkButton" IsDefault="True" Appearance="Primary" MinWidth="80" Click="OnOkClick" Margin="0,0,8,0" />
            <ui:Button x:Name="CancelButton" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
