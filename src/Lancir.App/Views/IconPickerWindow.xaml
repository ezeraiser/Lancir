<Window x:Class="Lancir.App.Views.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Width="420" WindowStyle="ToolWindow"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap" />
        <ItemsControl x:Name="SymbolList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Button Width="44" Height="44" Margin="0,0,6,6" Padding="0" HorizontalContentAlignment="Center"
                               Click="OnSymbolClick" Appearance="Secondary">
                        <ui:SymbolIcon Symbol="{Binding}" FontSize="20" />
                    </ui:Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button x:Name="UploadButton" Icon="{ui:SymbolIcon ImageAdd24}" Click="OnUploadClick" Margin="0,0,8,0" />
            <ui:Button x:Name="ResetButton" Click="OnResetClick" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <ui:Button x:Name="CancelButton" IsCancel="True" HorizontalAlignment="Right" MinWidth="80" Margin="0,12,0,0" />
    </StackPanel>
</Window>
