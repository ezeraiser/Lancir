<ui:FluentWindow x:Class="Lancir.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lancir.App.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lancir.App"
        xmlns:vm="clr-namespace:Lancir.App.ViewModels"
        xmlns:views="clr-namespace:Lancir.App.Views"
        xmlns:ctrl="clr-namespace:Lancir.App.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Lancir" Height="720" Width="1120"
        Icon="pack://application:,,,/Assets/Lancir.ico"
        MinHeight="480" MinWidth="720"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="NavButtonBase" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="NavLibraryStyle" TargetType="ui:Button" BasedOn="{StaticResource NavButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="Library">
                    <Setter Property="Appearance" Value="Secondary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavScanReviewStyle" TargetType="ui:Button" BasedOn="{StaticResource NavButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="ScanReview">
                    <Setter Property="Appearance" Value="Secondary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSettingsStyle" TargetType="ui:Button" BasedOn="{StaticResource NavButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                    <Setter Property="Appearance" Value="Secondary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavDebugConsoleStyle" TargetType="ui:Button" BasedOn="{StaticResource NavButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="DebugConsole">
                    <Setter Property="Appearance" Value="Secondary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lancir" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Lancir.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" x:Name="ContentGrid" SizeChanged="OnContentGridSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn">
                    <ColumnDefinition.Width>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource BoolToGridLengthConverter}"
                                 ConverterParameter="56|220" />
                    </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition>
                    <ColumnDefinition.Width>
                        <Binding Path="LibraryViewModel.HasSelectedGame" Converter="{StaticResource BoolToGridLengthConverter}"
                                 ConverterParameter="6|0" />
                    </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition x:Name="DetailsPaneColumn">
                    <ColumnDefinition.Width>
                        <MultiBinding Converter="{StaticResource PaneOpenWidthConverter}" Mode="TwoWay">
                            <Binding Path="LibraryViewModel.HasSelectedGame" />
                            <Binding Path="DetailsPaneWidth" Mode="TwoWay" />
                        </MultiBinding>
                    </ColumnDefinition.Width>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8,8" LastChildFill="False">
                <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon Navigation24}"
                           Appearance="Transparent" HorizontalAlignment="Stretch"
                           Margin="4,0,4,9" Command="{Binding ToggleNavCommand}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Padding" Value="10,9" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button DockPanel.Dock="Top" Content="{loc:Tr 'Kütüphane'}" Icon="{ui:SymbolIcon XboxController24}" Style="{StaticResource NavLibraryStyle}"
                           Command="{Binding GoToLibraryCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" ConverterParameter="Invert" />
                    </ui:Button.Visibility>
                </ui:Button>
                <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon XboxController24}" HorizontalContentAlignment="Center" Padding="0,9" ToolTip="{loc:Tr 'Kütüphane'}" Style="{StaticResource NavLibraryStyle}"
                           Command="{Binding GoToLibraryCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" />
                    </ui:Button.Visibility>
                </ui:Button>

                <ui:Button DockPanel.Dock="Top" Content="{loc:Tr 'Klasör Tara'}" Icon="{ui:SymbolIcon FolderSearch24}" Style="{StaticResource NavScanReviewStyle}"
                           Command="{Binding GoToScanReviewCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" ConverterParameter="Invert" />
                    </ui:Button.Visibility>
                </ui:Button>
                <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon FolderSearch24}" HorizontalContentAlignment="Center" Padding="0,9" ToolTip="{loc:Tr 'Klasör Tara'}" Style="{StaticResource NavScanReviewStyle}"
                           Command="{Binding GoToScanReviewCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" />
                    </ui:Button.Visibility>
                </ui:Button>

                <ui:Button DockPanel.Dock="Top" Content="{loc:Tr 'Ayarlar'}" Icon="{ui:SymbolIcon Settings24}" Style="{StaticResource NavSettingsStyle}"
                           Command="{Binding GoToSettingsCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" ConverterParameter="Invert" />
                    </ui:Button.Visibility>
                </ui:Button>
                <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon Settings24}" HorizontalContentAlignment="Center" Padding="0,9" ToolTip="{loc:Tr 'Ayarlar'}" Style="{StaticResource NavSettingsStyle}"
                           Command="{Binding GoToSettingsCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" />
                    </ui:Button.Visibility>
                </ui:Button>

                <ui:Button DockPanel.Dock="Top" Content="{loc:Tr 'Debug Konsol'}" Icon="{ui:SymbolIcon Bug24}" Style="{StaticResource NavDebugConsoleStyle}"
                           Command="{Binding GoToDebugConsoleCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" ConverterParameter="Invert" />
                    </ui:Button.Visibility>
                </ui:Button>
                <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon Bug24}" HorizontalContentAlignment="Center" Padding="0,9" ToolTip="{loc:Tr 'Debug Konsol'}" Style="{StaticResource NavDebugConsoleStyle}"
                           Command="{Binding GoToDebugConsoleCommand}">
                    <ui:Button.Visibility>
                        <Binding Path="IsNavCollapsed" Converter="{StaticResource NullToVisibilityConverter}" />
                    </ui:Button.Visibility>
                </ui:Button>
            </DockPanel>

            <Grid Grid.Column="1" Margin="0,0,20,20">
                <views:LibraryView DataContext="{Binding LibraryViewModel}">
                    <views:LibraryView.Visibility>
                        <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=Window}"
                                 Converter="{StaticResource EnumEqualsToVisibilityConverter}"
                                 ConverterParameter="Library" />
                    </views:LibraryView.Visibility>
                </views:LibraryView>

                <views:ScanReviewView DataContext="{Binding ScanReviewViewModel}">
                    <views:ScanReviewView.Visibility>
                        <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=Window}"
                                 Converter="{StaticResource EnumEqualsToVisibilityConverter}"
                                 ConverterParameter="ScanReview" />
                    </views:ScanReviewView.Visibility>
                </views:ScanReviewView>

                <views:SettingsView DataContext="{Binding SettingsViewModel}">
                    <views:SettingsView.Visibility>
                        <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=Window}"
                                 Converter="{StaticResource EnumEqualsToVisibilityConverter}"
                                 ConverterParameter="Settings" />
                    </views:SettingsView.Visibility>
                </views:SettingsView>

                <views:DebugConsoleView DataContext="{Binding DebugConsoleViewModel}">
                    <views:DebugConsoleView.Visibility>
                        <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=Window}"
                                 Converter="{StaticResource EnumEqualsToVisibilityConverter}"
                                 ConverterParameter="DebugConsole" />
                    </views:DebugConsoleView.Visibility>
                </views:DebugConsoleView>
            </Grid>

            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" DragCompleted="OnSplitterDragCompleted">
                <GridSplitter.Visibility>
                    <Binding Path="LibraryViewModel.HasSelectedGame" Converter="{StaticResource NullToVisibilityConverter}" />
                </GridSplitter.Visibility>
            </GridSplitter>

            <!-- Selected game detail side panel (Playnite-style): a real column next to the
                 library grid, resizable via the GridSplitter above, not an overlay. -->
            <Border Grid.Column="3" ClipToBounds="True" CornerRadius="12" SizeChanged="OnDetailsPaneSizeChanged"
                    Margin="0,0,12,12"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <Border.Visibility>
                    <Binding Path="LibraryViewModel.SelectedGame" Converter="{StaticResource NullToVisibilityConverter}" />
                </Border.Visibility>

                <Grid>
                    <!-- Panel background, two layers: a heavily blurred copy stretched to fill the whole panel,
                         and the art itself fitted to the panel width (nothing cropped sideways), anchored to the top
                         and faded out at its bottom edge. -->
                    <Border Margin="-80" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                        ctrl:AsyncImage.DecodeWidth="240"
                                        ctrl:AsyncImage.Source="{Binding LibraryViewModel.SelectedGame.PanelBackgroundPath}" />
                        </Border.Background>
                    </Border>
                    <Image Stretch="Uniform" VerticalAlignment="Top"
                           ctrl:AsyncImage.DecodeWidth="1200"
                           ctrl:AsyncImage.Source="{Binding LibraryViewModel.SelectedGame.PanelBackgroundPath}">
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="0.6" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                    </Image>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#80000000" Offset="0" />
                                <GradientStop Color="#99000000" Offset="0.5" />
                                <GradientStop Color="#CC101010" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Panel.ZIndex="1"
                               Click="OnCloseDetailsClick">
                        <!-- the picture viewer has its own close button in the same corner -->
                        <ui:Button.Visibility>
                            <Binding Path="GamePanelViewModel.IsViewerOpen" Converter="{StaticResource NullToVisibilityConverter}" ConverterParameter="Invert" />
                        </ui:Button.Visibility>
                    </ui:Button>

                    <views:GamePanelView DataContext="{Binding GamePanelViewModel}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
